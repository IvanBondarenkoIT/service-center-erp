# Database (Postgres local via compose on port 5433)
DATABASE_URL=sqlite:///./scerp_local.db
# DATABASE_URL=postgresql+psycopg2://scerp:scerp@localhost:5433/service_center_erp
SECRET_KEY=change-me-local-dev-secret

# Seed passwords (change in prod)
SEED_ADMIN_PASSWORD=admin123
SEED_MECHANIC_PASSWORD=mechanic123
SEED_ACCOUNTANT_PASSWORD=accountant123

# Firebird ERP via HTTP proxy (copy PROXY_API_TOKEN from granit-daily-sales-bot/.env)
PROXY_API_URL=http://178.63.72.227:8010
PROXY_API_TOKEN=
PROXY_API_TIMEOUT=90
PROXY_API_MAX_RETRIES=3

# ERP catalog sync — gentle incremental pulls
ERP_SYNC_BATCH_SIZE=150
ERP_SYNC_PAUSE_MS=500
ERP_SYNC_MAX_BATCHES=20
ERP_SYNC_STALE_HOURS=24
ERP_SYNC_REFRESH_BATCH=100

# Database (Postgres local via compose on port 5433)
DATABASE_URL=sqlite:///./scerp_local.db
# DATABASE_URL=postgresql+psycopg2://scerp:scerp@localhost:5433/service_center_erp
SECRET_KEY=change-me-local-dev-secret

# Seed: users (login:role:center:name, pipe-separated). Extra mechanic = extra chunk, no code change.
# SEED_USERS=admin:admin::Администратор|accountant:accountant::Бухгалтер|mechanic_batumi:mechanic:batumi:Механик Батуми|mechanic_tbilisi1:mechanic:tbilisi:Механик Тбилиси 1|mechanic_tbilisi2:mechanic:tbilisi2:Механик Тбилиси 2
SEED_ADMIN_PASSWORD=admin123
SEED_MECHANIC_PASSWORD=mechanic123
SEED_ACCOUNTANT_PASSWORD=accountant123
# Optional per-login override:
# SEED_PASSWORD_MECHANIC_BATUMI=change-me

# Firebird ERP via HTTP proxy (copy PROXY_API_TOKEN from granit-daily-sales-bot/.env)
PROXY_API_URL=http://178.63.72.227:8010
PROXY_API_TOKEN=
PROXY_API_TIMEOUT=90
PROXY_API_MAX_RETRIES=3

# ERP catalog sync — gentle incremental pulls
ERP_SYNC_BATCH_SIZE=150
ERP_SYNC_PAUSE_MS=500
ERP_SYNC_MAX_BATCHES=20
ERP_SYNC_STALE_HOURS=24
ERP_SYNC_REFRESH_BATCH=100
# Granit clients sync (ORGN + purchase summary)
ERP_CLIENTS_BATCH_SIZE=500
ERP_CLIENTS_MAX_BATCHES=40

# Cookies: true behind HTTPS (alt server), false locally over http
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Альт-сервер (~/apps/service-center-erp/.env, кладёт deploy hub). Только заглушки!
# С дефолтным SECRET_KEY или дефолтными SEED_* паролями приложение не стартует.
# ---------------------------------------------------------------------------
# APP_ENV=production
# DATABASE_URL=postgresql://scerp:<пароль роли scerp>@pg-core:5432/granit
# SECRET_KEY=<openssl rand -hex 32>
# SESSION_COOKIE_SECURE=true
# SEED_ADMIN_PASSWORD=<надёжный пароль>
# SEED_MECHANIC_PASSWORD=<надёжный пароль>
# SEED_ACCOUNTANT_PASSWORD=<надёжный пароль>
# PROXY_API_URL=http://178.63.72.227:8010
# PROXY_API_TOKEN=<токен из granit-daily-sales-bot/.env>
# IMAGE_TAG=main

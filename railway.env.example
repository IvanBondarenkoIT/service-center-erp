# Railway Dashboard → Variables
# Не задавайте PORT: Railway подставляет свой (часто 8080). Локальный 8035 сюда не копировать.
# DATABASE_URL должен быть reference на сервис Postgres в ЭТОМ проекте, не localhost:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Если в Postgres нет DATABASE_PRIVATE_URL — не используйте его, получите пустую строку.
# postgres://… нормализуется в postgresql+psycopg2:// в приложении.

SECRET_KEY=generate-a-long-random-string
SEED_ADMIN_PASSWORD=change-me
SEED_MECHANIC_PASSWORD=change-me
SEED_ACCOUNTANT_PASSWORD=change-me

# Опционально: кеш каталога ERP. Без них заказы работают, /dict/erp-catalog пустой.
# PROXY_API_URL=http://YOUR_PROXY_HOST:8010
# PROXY_API_TOKEN=your-token
